// BORRADOR — no está desplegado. Reglas para Firestore.
// Pegar en Firebase Console → Firestore → Reglas, DESPUÉS de publicar el
// sitio con inicio de sesión y de dar de alta a los administradores:
// colección `admins`, un documento por persona cuyo ID es su correo en
// minúsculas (el contenido puede ir vacío).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@udem[.]edu$');
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function votingOpen() {
      return get(/databases/$(database)/documents/settings/voting).data.votingOpen == true;
    }

    // Proyectos: cualquiera los ve; solo cuentas @udem.edu los crean o editan,
    // con límites de tamaño; solo administración los borra.
    match /projects/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() <= 160
        && request.resource.data.teamName.size() <= 200
        && request.resource.data.description.size() <= 280
        && request.resource.data.coverUrl.size() <= 400000
        && request.resource.data.career in ['LDG', 'LAED', 'LDM', 'LINT', 'LDI', 'LA', 'POSG'];
      allow delete: if isAdmin();
    }

    // Votos: un documento por cuenta y categoría, con id fijo
    // (edición_uid_categoría), creado una sola vez. Solo administración los
    // lista o borra; cada quien puede consultar si ya votó.
    match /votes/{voteId} {
      allow list, delete: if isAdmin();
      allow get: if isAdmin()
        || (signedIn() && voteId.matches('.*_' + request.auth.uid + '_.*'));
      allow create: if signedIn() && votingOpen()
        && voteId == request.resource.data.edition + '_' + request.auth.uid + '_' + request.resource.data.career
        && request.resource.data.voterUid == request.auth.uid
        && request.resource.data.voterEmail == request.auth.token.email;
      allow update: if false;
    }

    // Abrir y cerrar la votación: lectura pública, escritura solo administración.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cada quien puede comprobar si su propio correo es administrador.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false; // se dan de alta desde la consola
    }
  }
}
